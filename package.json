{
  "name": "gym-management-saas",
  "version": "0.1.0",
  "type": "module",
  "description": "Lightweight gym management SaaS for fitness facilities in East Africa",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "backend:dev": "npm run dev -w backend",
    "frontend:dev": "npm run dev -w frontend",
    "backend:build": "npm run build -w backend",
    "frontend:build": "npm run build -w frontend",
    "backend:test": "npm run test -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run db:seed -w backend",
    "db:setup": "npm run db:setup -w backend",
    "setup": "npm install && npm install -w backend && npm install -w frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  },
  "dependencies": {
    "esbuild": "^0.28.0"
  }
}
